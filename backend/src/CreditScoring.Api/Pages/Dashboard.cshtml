@page "/dashboard"
@model DashboardModel
@using System.Globalization
@using CreditScoring.Api.Reporting
@{
    ViewData["Title"] = "Dashboard";
    var s = Model.Stats;
    string Pct(double? rate) => rate is { } r ? r.ToString("P1") : "–";
    string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    const double Width = 640, Height = 252, Left = 36, Right = 20, Top = 32, Bottom = 32;
    var plotWidth = Width - Left - Right;
    var plotHeight = Height - Top - Bottom;
    var binWidth = plotWidth / s.PBadHistogram.Count;
    var maxCount = Math.Max(1, s.PBadHistogram.Count == 0 ? 1 : s.PBadHistogram.Max(b => b.Count));
    double X(double p) => Left + p * plotWidth;
    double Y(int count) => Top + plotHeight - (double)count / maxCount * plotHeight;
    string Bar(double x, double y, double w, double h)
    {
        var r = Math.Min(4, Math.Min(w / 2, h));
        return $"M{F(x)},{F(y + h)} V{F(y + r)} Q{F(x)},{F(y)} {F(x + r)},{F(y)} H{F(x + w - r)} Q{F(x + w)},{F(y)} {F(x + w)},{F(y + r)} V{F(y + h)} Z";
    }
    string Range(HistogramBin b) => $"{b.From:P0} – {b.To:P0}";
    var rows = new (string Label, MatrixRow Row, bool HasRecommendation, FinalDecision? Agrees, HistoryOutcome Outcome)[]
    {
        ("Model recommends approve", s.Matrix.Approve, true, FinalDecision.Approve, HistoryOutcome.Approve),
        ("Model asks for a closer review", s.Matrix.Review, false, null, HistoryOutcome.Review),
        ("Model recommends reject", s.Matrix.Reject, true, FinalDecision.Reject, HistoryOutcome.Reject),
        ("No score", s.Matrix.Unavailable, false, null, HistoryOutcome.ScoringUnavailable),
    };
    async Task Cell(int count, HistoryOutcome outcome, ReviewFilter review)
    {
        if (count == 0)
        {
            @count
        }
        else
        {
            <a class="cell-link" asp-page="/Applications/Index" asp-all-route-data="Model.HistoryRoute(outcome, review)">@count</a>
        }
    }
}

@section Band {
    <div>
        <h1>Dashboard</h1>
        <p>How the model's recommendations and the officers' decisions compare. Every number is counted from stored applications.</p>
    </div>
}

<form method="get" class="toolbar">
    <div class="dates">
        <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" aria-label="From date">
        <span>to</span>
        <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" aria-label="To date">
    </div>
    <button type="submit" class="button button-small">Apply</button>
    @if (Model.From is not null || Model.To is not null)
    {
        <a class="link-button" asp-page="/Dashboard">All time</a>
    }
</form>

@if (s.Applications == 0)
{
    <section class="panel">
        <div class="empty">
            <h2>No applications in this range</h2>
            <p>Choose a wider range, or submit applications to see figures here.</p>
        </div>
    </section>
}
else
{
    <div class="stat-row stat-row-4">
        <a class="panel stat stat-link" asp-page="/Applications/Index" asp-all-route-data="Model.HistoryRoute()"><span class="stat-value">@s.Applications</span><span class="stat-label">Applications</span></a>
        <a class="panel stat stat-link" asp-page="/Applications/Index" asp-all-route-data="Model.HistoryRoute(review: ReviewFilter.Pending)"><span class="stat-value">@s.Pending</span><span class="stat-label">Awaiting decision</span></a>
        <a class="panel stat stat-link" asp-page="/Applications/Index" asp-all-route-data="Model.HistoryRoute(review: ReviewFilter.Override)"><span class="stat-value">@Pct(s.OverrideRate)</span><span class="stat-label">Decisions against the model</span></a>
        <a class="panel stat stat-link" asp-page="/Applications/Index" asp-all-route-data="Model.HistoryRoute(HistoryOutcome.ScoringUnavailable)"><span class="stat-value">@Pct(s.UnavailableRate)</span><span class="stat-label">Scoring unavailable</span></a>
    </div>

    <h2 class="section-title">Recommendation and decision</h2>
    <section class="panel">
        <table class="data-table">
            <thead>
                <tr><th scope="col"></th><th scope="col" class="num">Officer approved</th><th scope="col" class="num">Officer rejected</th><th scope="col" class="num">Awaiting</th><th scope="col" class="num">Against the model</th></tr>
            </thead>
            <tbody>
                @foreach (var (label, row, hasRecommendation, agrees, outcome) in rows)
                {
                    <tr>
                        <th scope="row">@label</th>
                        <td class="num @(agrees == FinalDecision.Reject ? "cell-override" : null)">@{ await Cell(row.Approved, outcome, ReviewFilter.Approved); }</td>
                        <td class="num @(agrees == FinalDecision.Approve ? "cell-override" : null)">@{ await Cell(row.Rejected, outcome, ReviewFilter.Rejected); }</td>
                        <td class="num muted">@{ await Cell(row.Pending, outcome, ReviewFilter.Pending); }</td>
                        <td class="num">
                            @if (hasRecommendation)
                            {
                                @Pct(agrees == FinalDecision.Approve ? s.HighSideOverrideRate : s.LowSideOverrideRate)
                            }
                            else
                            {
                                <span class="muted">reason required</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="panel-foot">Select a count to open those applications in History. Highlighted cells are decisions against the model. Rejecting an applicant the model would approve is the cautious side; approving one it would reject carries the risk. Rates are out of decided applications in that row.</div>
    </section>

    <h2 class="section-title">P(bad) of scored applications</h2>
    <section class="panel">
        <div class="chart">
            <svg viewBox="0 0 @F(Width) @F(Height)" role="img" aria-label="Histogram of P(bad) in 10 bins">
                @foreach (var tick in new[] { 0, maxCount })
                {
                    <g>
                        <line class="chart-grid" x1="@F(Left)" x2="@F(Width - Right)" y1="@F(Y(tick))" y2="@F(Y(tick))" />
                        <text class="chart-label" x="@F(Left - 8)" y="@F(Y(tick) + 4)" text-anchor="end">@tick</text>
                    </g>
                }
                @foreach (var b in s.PBadHistogram)
                {
                    var x = X(b.From) + 1;
                    var w = binWidth - 2;
                    <g class="chart-bin">
                        <title>P(bad) @Range(b): @b.Count @(b.Count == 1 ? "application" : "applications")</title>
                        <rect class="chart-hit" x="@F(X(b.From))" y="@F(Top)" width="@F(binWidth)" height="@F(plotHeight)" />
                        @if (b.Count > 0)
                        {
                            <path class="chart-bar" d="@Bar(x, Y(b.Count), w, Top + plotHeight - Y(b.Count))" />
                        }
                    </g>
                }
                @for (var i = 0; i <= 10; i += 2)
                {
                    <g><text class="chart-label" x="@F(X(i / 10.0))" y="@F(Height - 10)" text-anchor="@(i == 10 ? "end" : i == 0 ? "start" : "middle")">@(i * 10)%</text></g>
                }
                @if (Model.Active is { } active)
                {
                    var tx = X(active.Threshold);
                    @if (active.ReviewFrom is { } reviewFrom)
                    {
                        var rx = X(reviewFrom);
                        <g>
                            <line class="chart-threshold chart-review" x1="@F(rx)" x2="@F(rx)" y1="@F(Top - 14)" y2="@F(Top + plotHeight)" />
                            <text class="chart-label chart-threshold-label" x="@F(rx - 6)" y="@F(Top - 16)" text-anchor="end">Review from @reviewFrom.ToString("P1")</text>
                        </g>
                    }
                    <g>
                        <line class="chart-threshold" x1="@F(tx)" x2="@F(tx)" y1="@F(Top - 14)" y2="@F(Top + plotHeight)" />
                        <text class="chart-label chart-threshold-label" x="@F(tx + 6)" y="@F(Top - 16)">Reject from @active.Threshold.ToString("P1")</text>
                    </g>
                }
            </svg>
        </div>
        <details class="chart-table">
            <summary>Show as a table</summary>
            <table class="data-table">
                <thead><tr><th scope="col">P(bad)</th><th scope="col" class="num">Applications</th></tr></thead>
                <tbody>
                    @foreach (var b in s.PBadHistogram)
                    {
                        <tr><td>@Range(b)</td><td class="num">@b.Count</td></tr>
                    }
                </tbody>
            </table>
        </details>
        <div class="panel-foot">Scores of the model that made each recommendation. The lines mark where the active model starts asking for a closer review and where it recommends rejecting; older applications may have been scored by another model.</div>
    </section>

    <div class="cards">
        <section class="panel">
            <div class="card-title">By officer</div>
            @if (s.Officers.Count == 0)
            {
                <div class="empty"><p>No decisions recorded in this range.</p></div>
            }
            else
            {
                <table class="data-table">
                    <thead><tr><th scope="col">Officer</th><th scope="col" class="num">Decisions</th><th scope="col" class="num">Against the model</th></tr></thead>
                    <tbody>
                        @foreach (var o in s.Officers)
                        {
                            <tr>
                                <th scope="row">@o.Name</th>
                                <td class="num">@o.Decisions</td>
                                <td class="num">@o.Overrides <span class="muted">(@Pct(o.OverrideRate))</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="panel">
            <div class="card-title">Shadow models</div>
            @if (s.ShadowAgreement.Count == 0)
            {
                <div class="empty"><p>No shadow scores in this range.</p></div>
            }
            else
            {
                <table class="data-table">
                    <thead><tr><th scope="col">Model</th><th scope="col" class="num">Compared</th><th scope="col" class="num">Same recommendation</th></tr></thead>
                    <tbody>
                        @foreach (var a in s.ShadowAgreement)
                        {
                            <tr>
                                <th scope="row" class="mono">@a.ModelId</th>
                                <td class="num">@a.Compared</td>
                                <td class="num">@a.Agreed <span class="muted">(@Pct(a.AgreementRate))</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>
}
