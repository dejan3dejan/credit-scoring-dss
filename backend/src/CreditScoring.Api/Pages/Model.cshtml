@page "/model"
@model ModelModel
@using System.Globalization
@{
    ViewData["Title"] = "Model";
    var active = Model.Active;
    var threshold = active?.Threshold ?? 0;
    const double LendingClubCostRatio = 2.0431;
    var isCostRatioThreshold = Math.Abs(threshold - 1 / (1 + LendingClubCostRatio)) < 5e-5;
    var reviewFrom = active?.ReviewFrom;
}

@section Band {
    <div>
        <h1>Model</h1>
        <p>What the scoring model is, what its number means, and where it should not be trusted.</p>
    </div>
}

@if (active is null)
{
    <div class="alert" role="alert">No model is set as active, so new applications are recorded without a score.</div>
}
else
{
    <div class="cards">
        <section class="panel">
            <div class="card-title">Deployed model</div>
            <dl class="kv">
                <div><dt>Model</dt><dd class="mono">@active.ModelId</dd></div>
                <div><dt>Type</dt><dd>@Labels.ModelName(active.DisplayName)</dd></div>
                <div><dt>Output</dt><dd>P(bad), probability of default</dd></div>
                @if (reviewFrom is { } from)
                {
                    <div><dt>Review closely</dt><dd>@from.ToString("P1") ≤ P(bad) &lt; @threshold.ToString("P1")</dd></div>
                }
                <div><dt>Reject rule</dt><dd>P(bad) ≥ @threshold.ToString("P1") <span class="muted mono">(@threshold.ToString("0.####", CultureInfo.InvariantCulture))</span></dd></div>
                <div><dt>Recommendation only</dt><dd>The loan officer decides</dd></div>
            </dl>
        </section>

        <section class="panel">
            <div class="card-title">Why the threshold is @threshold.ToString("P1")</div>
            <div class="prose">
                @if (isCostRatioThreshold)
                {
                    <p>In the training loans, a loan that defaulted lost on average <strong>$4,203.69</strong>, and a loan paid back in full earned on average <strong>$2,057.47</strong>. A missed default therefore costs about <strong>2.04 times</strong> as much as turning away a good borrower.</p>
                    <p>Rejecting is cheaper on average once P(bad) reaches 1 / (1 + 2.0431), about 32.9%. Below that, approving is cheaper.</p>
                    <p class="muted">The amounts are what borrowers paid back minus what was lent, from Lending Club's records. They leave out funding cost and the time value of money.</p>
                }
                else
                {
                    <p>This threshold was recommended with the model and fixed when it was registered. A different threshold means registering the model again.</p>
                }
            </div>
        </section>

        <section class="panel">
            <div class="card-title">Training data</div>
            <dl class="kv">
                <div><dt>Dataset</dt><dd>Lending Club accepted loans</dd></div>
                <div><dt>Dataset id</dt><dd class="mono">@active.Dataset</dd></div>
                <div><dt>Training loans</dt><dd>306,462 36-month loans issued 2012 to 2014, 13.3% not repaid</dd></div>
                <div><dt>Tested once on</dt><dd>283,026 loans issued in 2015</dd></div>
                <div><dt>Currency</dt><dd>US dollars</dd></div>
            </dl>
        </section>

        <section class="panel">
            <div class="card-title">Accepted inputs</div>
            <dl class="kv">
                <div><dt>Loan amount</dt><dd>@BusinessLimits.MinLoanAmount.ToString("N0") – @BusinessLimits.MaxLoanAmount.ToString("N0") USD</dd></div>
                <div><dt>Loan term</dt><dd>@BusinessLimits.TermMonths months only</dd></div>
                <div><dt>Credit score</dt><dd>@BusinessLimits.MinCreditScore – @BusinessLimits.MaxCreditScore</dd></div>
                <div><dt>Why these ranges</dt><dd>They follow Lending Club's loans of that period; extreme values are capped inside the model</dd></div>
            </dl>
        </section>
    </div>
}

@if (Model.CanManage)
{
    <h2 class="section-title">Registry</h2>
    @if (Model.Conflict is { } conflict)
    {
        <div class="alert" role="alert">@conflict</div>
    }
    <div asp-validation-summary="ModelOnly" class="alert"></div>
    <section class="panel">
        <div class="registry">
            @foreach (var m in Model.Models)
            {
                var tone = m.Role switch { ModelRole.Active => "approve", ModelRole.Shadow => "pending", _ => "retired" };
                var posted = Model.ModelId == m.ModelId;
                <div class="registry-row">
                    <div class="registry-main">
                        <div class="registry-name">
                            @Labels.ModelName(m.DisplayName)
                            <span class="status status-@tone">@Labels.Of(m.Role)</span>
                        </div>
                        <div class="registry-meta"><span class="mono">@m.ModelId</span>@(m.ReviewFrom is { } rf ? $" · review from {rf:P1}" : "") · rejects at @m.Threshold.ToString("P1") · registered @m.RegisteredAt.ToLocalTime().ToString("d MMM yyyy")</div>
                    </div>
                    @if (m.Role == ModelRole.Shadow)
                    {
                        <form method="post" class="registry-form">
                            <input type="hidden" name="ModelId" value="@m.ModelId">
                            <div class="registry-actions">
                                <input name="Reason" value="@(posted ? Model.Reason : null)" placeholder="Reason for the change" maxlength="@BusinessLimits.DecisionReasonMaxLength" aria-label="Reason for changing @m.ModelId" class="@(posted && !ViewData.ModelState.IsValid ? "input-validation-error" : null)">
                                <button type="submit" class="button button-small" asp-page-handler="Promote">Make active</button>
                                <button type="submit" class="button button-small" asp-page-handler="Retire">Retire</button>
                            </div>
                            @if (posted)
                            {
                                <span asp-validation-for="Reason" class="error"></span>
                            }
                        </form>
                    }
                </div>
            }
        </div>
        <div class="panel-foot">Shadow models score every new application next to the active one. Only the active model makes the recommendation, and officers do not see shadow scores.</div>
    </section>

    <h2 class="section-title">Available to register</h2>
    <section class="panel">
        @if (Model.Available is null)
        {
            <div class="empty">
                <h2>The inference service could not list its models</h2>
                <p>Registered models are unaffected. Try again once the service is running.</p>
            </div>
        }
        else if (Model.Available.Count == 0)
        {
            <div class="empty">
                <h2>Nothing new to register</h2>
                <p>Every model the inference service serves is already in the registry.</p>
            </div>
        }
        else
        {
            <div class="registry">
                @foreach (var m in Model.Available)
                {
                    <div class="registry-row">
                        <div class="registry-main">
                            <div class="registry-name">@Labels.ModelName(m.ModelName)</div>
                            <div class="registry-meta"><span class="mono">@m.ModelId</span>@(m.ReviewFrom is { } rf ? $" · review from {rf:P1}" : "") · recommended threshold @m.RecommendedThreshold.ToString("P1") · trained @m.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</div>
                        </div>
                        <form method="post" asp-page-handler="Register">
                            <input type="hidden" name="ModelId" value="@m.ModelId">
                            <button type="submit" class="button button-small">Register as shadow</button>
                        </form>
                    </div>
                }
            </div>
        }
        <div class="panel-foot">A model starts as a shadow. Its threshold and review band are the ones it was trained with and cannot be changed afterwards.</div>
    </section>

    <h2 class="section-title">Change log</h2>
    <section class="panel">
        @if (Model.Events.Count == 0)
        {
            <div class="empty"><h2>No changes yet</h2><p>Registrations and role changes appear here with who made them and why.</p></div>
        }
        else
        {
            <ol class="registry-log">
                @foreach (var e in Model.Events)
                {
                    <li>
                        <div>
                            <span class="mono">@e.ModelId</span>
                            @(e.FromRole is { } from ? $"{Labels.Of(from)} → {Labels.Of(e.ToRole)}" : $"registered as {Labels.Of(e.ToRole).ToLowerInvariant()}")
                        </div>
                        @if (e.Reason is { } reason)
                        {
                            <div class="registry-reason">“@reason”</div>
                        }
                        <div class="registry-meta">@e.ChangedBy · @e.ChangedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</div>
                    </li>
                }
            </ol>
        }
    </section>
}

<section class="panel limits">
    <div class="card-title">Known limitations</div>
    <ul class="limit-list">
        <li><strong>Approved loans only.</strong> The model learned from loans Lending Club granted. It never saw how the applicants it turned away would have repaid, so its estimates are least reliable for applicants unlike those it approved.</li>
        <li><strong>One country and period.</strong> The loans are US loans issued from 2012 to 2014. Tested once on loans from 2015, it predicted somewhat fewer defaults than occurred.</li>
        <li><strong>36-month loans only.</strong> Longer terms were left out, so the form offers no other term.</li>
        <li><strong>The review band is not a safeguard by itself.</strong> It marks the applications where the model is least sure. It lowers losses only if the officer's closer look judges those cases better than the model does.</li>
        <li><strong>A recommendation, not a decision.</strong> Every application needs the officer's decision, with a reason when it goes against the model, when the model asks for a closer review, or when no score was available.</li>
        <li><strong>Performance figures</strong> are kept in the experiment log and are not shown on this page.</li>
    </ul>
</section>
