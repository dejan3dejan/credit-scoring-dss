@page "/clients"
@model CreditScoring.Api.Pages.Clients.IndexModel
@using CreditScoring.Api.Auth
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@{
    ViewData["Title"] = "Clients";
    var r = Model.Result;
    var first = r.TotalCount == 0 ? 0 : (r.Page - 1) * r.PageSize + 1;
    var last = Math.Min(r.Page * r.PageSize, r.TotalCount);
    var canDecide = (await Authorization.AuthorizeAsync(User, Permissions.ClientsWrite)).Succeeded;
}

@section Band {
    <div>
        <h1>Clients</h1>
        <p>Everyone who has applied, with their applications and decisions.</p>
    </div>
    @if (canDecide)
    {
        <a class="button button-primary" asp-page="/Clients/New">New client</a>
    }
}

<form method="get" class="toolbar">
    <label class="search">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <input name="search" value="@Model.Search" placeholder="Search by name or client number" aria-label="Search clients" maxlength="@BusinessLimits.ApplicantNameMaxLength" autocomplete="off">
    </label>
    <button type="submit" class="button">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a asp-page="/Clients/Index">Clear</a>
    }
</form>

<section class="panel">
    @if (r.TotalCount == 0)
    {
        <div class="empty">
            <h2>@(string.IsNullOrWhiteSpace(Model.Search) ? "No clients yet" : "No results")</h2>
            <p>@(string.IsNullOrWhiteSpace(Model.Search) ? "Clients appear here once they are added." : "No client matches this name or number.")</p>
        </div>
    }
    else
    {
        <div class="chats">
            @foreach (var c in r.Items)
            {
                <a class="chat" asp-page="/Clients/Details" asp-route-id="@c.Id">
                    <span class="avatar tone-@Avatar.Tone(c.FullName)" aria-hidden="true">@Avatar.Initials(c.FullName)</span>
                    <span class="chat-main">
                        <span class="chat-name">@c.FullName</span>
                        <span class="chat-line"><span class="mono">@c.ClientNumber</span>@(c.DateOfBirth is { } dob ? $" · born {dob:d MMM yyyy}" : "")</span>
                    </span>
                    <span class="chat-end">
                        <span class="chat-time">@(c.LastApplicationAt is { } lastAt ? "Last applied " + lastAt.ToLocalTime().ToString("d MMM yyyy") : "No applications")</span>
                        <span class="status status-pending">@(c.ApplicationCount == 1 ? "1 application" : $"{c.ApplicationCount} applications")</span>
                    </span>
                </a>
            }
        </div>
        <div class="pager">
            <span>@first–@last of @r.TotalCount</span>
            <div class="pager-links">
                @if (r.Page > 1)
                {
                    <a class="button button-small" asp-page="/Clients/Index" asp-route-search="@Model.Search" asp-route-p="@(r.Page - 1)">Previous</a>
                }
                @if (last < r.TotalCount)
                {
                    <a class="button button-small" asp-page="/Clients/Index" asp-route-search="@Model.Search" asp-route-p="@(r.Page + 1)">Next</a>
                }
            </div>
        </div>
    }
</section>
