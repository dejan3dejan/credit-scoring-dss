@page "/applications"
@model CreditScoring.Api.Pages.Applications.IndexModel
@using CreditScoring.Api.Auth
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@{
    ViewData["Title"] = "History";
    var r = Model.Result;
    var first = r.TotalCount == 0 ? 0 : (r.Page - 1) * r.PageSize + 1;
    var last = Math.Min(r.Page * r.PageSize, r.TotalCount);
    var canDecide = (await Authorization.AuthorizeAsync(User, Policies.CanDecide)).Succeeded;
    var outcomes = new (HistoryOutcome? Value, string Label)[]
    {
        (null, "All"),
        (HistoryOutcome.Approve, "Approve"),
        (HistoryOutcome.Reject, "Reject"),
        (HistoryOutcome.ScoringUnavailable, "Unavailable"),
    };
}

@section Band {
    <div>
        <h1>History</h1>
        <p>Every application and the recommendation it received, newest first.</p>
    </div>
    @if (canDecide)
    {
        <a class="button button-primary" asp-page="New">New application</a>
    }
}

<form method="get" class="toolbar">
    <label class="search">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <input name="name" value="@Model.Name" placeholder="Search by applicant name" aria-label="Applicant name" maxlength="@BusinessLimits.ApplicantNameMaxLength" autocomplete="off">
    </label>
    <div class="filter-group">
        <span class="filter-label" id="model-filter">Model</span>
        <nav class="segmented" aria-labelledby="model-filter">
            @foreach (var (value, label) in outcomes)
            {
                <a asp-page="Index" asp-all-route-data="Model.RouteFor(value)" class="@(Model.Outcome == value ? "selected" : null)">@label</a>
            }
        </nav>
    </div>
    <div class="filter-group">
        <span class="filter-label" id="review-filter">Decision</span>
        <nav class="segmented" aria-labelledby="review-filter">
            <a asp-page="Index" asp-all-route-data="Model.RouteFor((ReviewFilter?)null)" class="@(Model.Review is null ? "selected" : null)">All</a>
            @foreach (var review in Enum.GetValues<ReviewFilter>())
            {
                <a asp-page="Index" asp-all-route-data="Model.RouteFor(review)" class="@(Model.Review == review ? "selected" : null)">@(review == ReviewFilter.Pending ? "Pending" : Labels.Of(review))</a>
            }
        </nav>
    </div>
    <div class="dates">
        <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" aria-label="From date">
        <span>to</span>
        <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" aria-label="To date">
    </div>
    @if (Model.Outcome is { } outcome)
    {
        <input type="hidden" name="outcome" value="@outcome">
    }
    @if (Model.Review is { } reviewValue)
    {
        <input type="hidden" name="review" value="@reviewValue">
    }
    <button type="submit" class="button">Search</button>
    @if (Model.IsFiltered)
    {
        <a asp-page="Index">Clear</a>
    }
</form>

<section class="panel">
    @if (r.TotalCount == 0)
    {
        <div class="empty">
            <h2>@(Model.IsFiltered ? "No results" : "No applications yet")</h2>
            <p>@(Model.IsFiltered ? "No applications match these filters." : "Submitted applications appear here with their recommendation.")</p>
        </div>
    }
    else
    {
        <div class="chats">
            @foreach (var item in r.Items)
            {
                <partial name="_ApplicationRow" model="item" />
            }
        </div>
        <div class="pager">
            <span>@first–@last of @r.TotalCount · The percentage is P(bad), the estimated probability of default</span>
            <div class="pager-links">
                @if (r.Page > 1)
                {
                    <a class="button button-small" asp-page="Index" asp-all-route-data="Model.RouteFor(r.Page - 1)">Previous</a>
                }
                @if (last < r.TotalCount)
                {
                    <a class="button button-small" asp-page="Index" asp-all-route-data="Model.RouteFor(r.Page + 1)">Next</a>
                }
            </div>
        </div>
    }
</section>
