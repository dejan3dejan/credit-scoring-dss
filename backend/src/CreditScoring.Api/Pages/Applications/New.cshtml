@page "/applications/new"
@model CreditScoring.Api.Pages.Applications.NewModel
@{
    ViewData["Title"] = "New application";
    var errorCount = ModelState.ErrorCount;
    var client = Model.Client;
}

@section Band {
    <div>
        <h1>New application</h1>
        <p>@(client is null
            ? "Choose the client who is applying, or add a new client."
            : "Enter the applicant's answers to get a recommendation. You make the decision; every submission is kept in History.")</p>
    </div>
}

@if (client is null)
{
    <form method="get" class="toolbar">
        <label class="search">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <input name="search" value="@Model.Search" placeholder="Search clients by name or client number" aria-label="Search clients" autocomplete="off" autofocus>
        </label>
        <button type="submit" class="button">Search</button>
        <a class="button button-primary" asp-page="/Clients/New">New client</a>
    </form>
    <section class="panel">
        @if (Model.Clients!.TotalCount == 0)
        {
            <div class="empty">
                <h2>No clients found</h2>
                <p>Add the applicant as a new client to start an application.</p>
            </div>
        }
        else
        {
            <div class="chats">
                @foreach (var c in Model.Clients.Items)
                {
                    <a class="chat" asp-page="/Applications/New" asp-route-clientId="@c.Id">
                        <span class="avatar tone-@Avatar.Tone(c.FullName)" aria-hidden="true">@Avatar.Initials(c.FullName)</span>
                        <span class="chat-main">
                            <span class="chat-name">@c.FullName</span>
                            <span class="chat-line"><span class="mono">@c.ClientNumber</span> · @(c.ApplicationCount == 1 ? "1 application" : $"{c.ApplicationCount} applications")</span>
                        </span>
                        <span class="chat-end"><span class="chat-time">Choose</span></span>
                    </a>
                }
            </div>
        }
    </section>
}
else
{
@if (errorCount > 0)
{
    <div class="alert" role="alert">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm-.75 3.5h1.5v5h-1.5v-5Zm.75 8a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/></svg>
        <div><strong>@(errorCount == 1 ? "1 answer needs" : $"{errorCount} answers need") attention.</strong> Nothing was saved. Correct the highlighted fields and submit again.</div>
    </div>
}

<section class="panel client-card">
    <span class="avatar tone-@Avatar.Tone(client.FullName)" aria-hidden="true">@Avatar.Initials(client.FullName)</span>
    <div class="client-card-main">
        <div class="client-card-name">@client.FullName</div>
        <div class="muted"><span class="mono">@client.ClientNumber</span>@(client.DateOfBirth is { } dob ? $" · born {dob:d MMM yyyy}" : "")</div>
    </div>
    <a class="button button-small" asp-page="/Applications/New">Change client</a>
</section>

@if (Model.Prefilled is { } previous)
{
    <div class="note note-spaced">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm.75 10.5h-1.5v-4.5h1.5v4.5ZM8 5.75a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/></svg>
        <div><strong>Pre-filled from the application of @previous.SubmittedAt.ToLocalTime().ToString("d MMM yyyy").</strong> Check every answer with the client before you submit; anything may have changed.</div>
    </div>
}

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert"></div>
    <input type="hidden" asp-for="Input.ClientId">

    <section class="panel">
        <div class="panel-body">
            <div class="panel-head">
                <h2>Loan</h2>
                <p>What is being requested.</p>
            </div>
            <div class="grid">
                <div class="field">
                    <label asp-for="Input.LoanAmount"></label>
                    <div class="affix"><input asp-for="Input.LoanAmount" type="text" inputmode="numeric" placeholder="@BusinessLimits.MinLoanAmount.ToString("N0")–@BusinessLimits.MaxLoanAmount.ToString("N0")"><span>USD</span></div>
                    <span asp-validation-for="Input.LoanAmount" class="error"></span>
                </div>
                <div class="field">
                    <span class="field-label">Term</span>
                    <div class="fixed-value">@BusinessLimits.TermMonths months</div>
                    <span class="hint">The model was trained on 36-month loans only</span>
                </div>
                <div class="field span-2">
                    <label asp-for="Input.Purpose"></label>
                    <select asp-for="Input.Purpose" asp-items="Labels.Options<LoanPurpose>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.Purpose" class="error"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-body">
            <div class="panel-head">
                <h2>Income and housing</h2>
                <p>What the applicant earns and already pays.</p>
            </div>
            <div class="grid">
                <div class="field">
                    <label asp-for="Input.AnnualIncome"></label>
                    <div class="affix"><input asp-for="Input.AnnualIncome" type="text" inputmode="decimal" placeholder="58000"><span>USD</span></div>
                    <span class="hint">Before tax, as stated by the applicant</span>
                    <span asp-validation-for="Input.AnnualIncome" class="error"></span>
                </div>
                <div class="field">
                    <span class="field-label" id="verification-label">@Html.DisplayNameFor(m => m.Input.IncomeVerification)</span>
                    <div class="segmented" role="radiogroup" aria-labelledby="verification-label">
                        @foreach (var option in Enum.GetValues<IncomeVerification>())
                        {
                            <input type="radio" asp-for="Input.IncomeVerification" value="@option" id="verification-@option"><label for="verification-@option">@Labels.Of(option)</label>
                        }
                    </div>
                    <span class="hint">Source verified: the income source was confirmed, not the amount</span>
                    <span asp-validation-for="Input.IncomeVerification" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.DebtToIncomePercent"></label>
                    <div class="affix"><input asp-for="Input.DebtToIncomePercent" type="text" inputmode="decimal" placeholder="0–@BusinessLimits.MaxDebtToIncomePercent"><span>%</span></div>
                    <span class="hint">Monthly debt payments as a share of monthly income, without this loan and the mortgage</span>
                    <span asp-validation-for="Input.DebtToIncomePercent" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.EmploymentLength"></label>
                    <select asp-for="Input.EmploymentLength" asp-items="Labels.Options<EmploymentLength>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.EmploymentLength" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.HomeOwnership"></label>
                    <select asp-for="Input.HomeOwnership" asp-items="Labels.Options<HomeOwnership>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.HomeOwnership" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.MortgageAccounts"></label>
                    <input asp-for="Input.MortgageAccounts" type="text" inputmode="numeric" placeholder="0">
                    <span asp-validation-for="Input.MortgageAccounts" class="error"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-body">
            <div class="panel-head">
                <h2>Credit report</h2>
                <p>From the applicant's credit bureau report.</p>
            </div>
            <div class="grid">
                <div class="field">
                    <label asp-for="Input.CreditScore"></label>
                    <input asp-for="Input.CreditScore" type="text" inputmode="numeric" placeholder="@BusinessLimits.MinCreditScore–@BusinessLimits.MaxCreditScore">
                    <span class="hint">FICO score</span>
                    <span asp-validation-for="Input.CreditScore" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.EarliestCreditLine"></label>
                    <input asp-for="Input.EarliestCreditLine" type="month" asp-format="{0:yyyy-MM}" placeholder="YYYY-MM">
                    <span class="hint">Month and year; the model uses the length of the credit history</span>
                    <span asp-validation-for="Input.EarliestCreditLine" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.InquiriesLast6Months"></label>
                    <input asp-for="Input.InquiriesLast6Months" type="text" inputmode="numeric" placeholder="0">
                    <span asp-validation-for="Input.InquiriesLast6Months" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.DelinquenciesLast2Years"></label>
                    <input asp-for="Input.DelinquenciesLast2Years" type="text" inputmode="numeric" placeholder="0">
                    <span class="hint">Payments 30 or more days late</span>
                    <span asp-validation-for="Input.DelinquenciesLast2Years" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.PublicRecords"></label>
                    <input asp-for="Input.PublicRecords" type="text" inputmode="numeric" placeholder="0">
                    <span asp-validation-for="Input.PublicRecords" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Bankruptcies"></label>
                    <input asp-for="Input.Bankruptcies" type="text" inputmode="numeric" placeholder="0">
                    <span asp-validation-for="Input.Bankruptcies" class="error"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-body">
            <div class="panel-head">
                <h2>Credit accounts</h2>
                <p>Cards and credit lines the applicant has now and has had.</p>
            </div>
            <div class="grid">
                <div class="field">
                    <label asp-for="Input.RevolvingBalance"></label>
                    <div class="affix"><input asp-for="Input.RevolvingBalance" type="text" inputmode="decimal" placeholder="0"><span>USD</span></div>
                    <span class="hint">Owed on credit cards and other revolving credit</span>
                    <span asp-validation-for="Input.RevolvingBalance" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.RevolvingUtilizationPercent"></label>
                    <div class="affix"><input asp-for="Input.RevolvingUtilizationPercent" type="text" inputmode="decimal" placeholder="0–@BusinessLimits.MaxRevolvingUtilizationPercent"><span>%</span></div>
                    <span class="hint">Balance as a share of the credit limit; 0 if there is no revolving credit</span>
                    <span asp-validation-for="Input.RevolvingUtilizationPercent" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.OpenAccounts"></label>
                    <input asp-for="Input.OpenAccounts" type="text" inputmode="numeric" placeholder="0">
                    <span asp-validation-for="Input.OpenAccounts" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.TotalAccounts"></label>
                    <input asp-for="Input.TotalAccounts" type="text" inputmode="numeric" placeholder="0">
                    <span class="hint">Open and closed</span>
                    <span asp-validation-for="Input.TotalAccounts" class="error"></span>
                </div>
            </div>
        </div>
        <div class="panel-foot">Amounts are in US dollars. The model learned from Lending Club loans issued 2012 to 2014; values far outside what it saw are capped by the model.</div>
    </section>

    <div class="action-bar">
        <span>Submitted as @User.Identity!.Name. You will get a recommendation, not a decision.</span>
        <button type="submit" class="button button-primary">Get recommendation</button>
    </div>
</form>
}
