@page "/applications/new"
@model CreditScoring.Api.Pages.Applications.NewModel
@{
    ViewData["Title"] = "New application";
    var errorCount = ModelState.ErrorCount;
}

@section Band {
    <div>
        <h1>New application</h1>
        <p>Enter the applicant's answers to get a recommendation. You make the decision; every submission is kept in History.</p>
    </div>
}

@if (errorCount > 0)
{
    <div class="alert" role="alert">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm-.75 3.5h1.5v5h-1.5v-5Zm.75 8a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/></svg>
        <div><strong>@(errorCount == 1 ? "1 answer needs" : $"{errorCount} answers need") attention.</strong> Nothing was saved. Correct the highlighted fields and submit again.</div>
    </div>
}

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert"></div>

    <section class="panel">
        <div class="panel-body">
            <div class="panel-head">
                <h2>Applicant</h2>
                <p>Who is applying.</p>
            </div>
            <div class="grid">
                <div class="field span-2">
                    <label asp-for="Input.ApplicantName"></label>
                    <input asp-for="Input.ApplicantName" placeholder="Full name" autocomplete="off" maxlength="@BusinessLimits.ApplicantNameMaxLength">
                    <span asp-validation-for="Input.ApplicantName" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Age"></label>
                    <div class="affix"><input asp-for="Input.Age" type="text" inputmode="numeric" placeholder="@BusinessLimits.MinAge–@BusinessLimits.MaxAge"><span>years</span></div>
                    <span asp-validation-for="Input.Age" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Dependants"></label>
                    <input asp-for="Input.Dependants" type="text" inputmode="numeric" placeholder="0">
                    <span class="hint">People the applicant provides maintenance for</span>
                    <span asp-validation-for="Input.Dependants" class="error"></span>
                </div>
                <div class="field span-2">
                    <label asp-for="Input.PersonalStatusSex"></label>
                    <select asp-for="Input.PersonalStatusSex" asp-items="Labels.Options<PersonalStatusSex>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.PersonalStatusSex" class="error"></span>
                </div>
                <div class="field">
                    <span class="field-label" id="tel-label">@Html.DisplayNameFor(m => m.Input.HasRegisteredTelephone)</span>
                    <div class="segmented" role="radiogroup" aria-labelledby="tel-label">
                        <input type="radio" asp-for="Input.HasRegisteredTelephone" value="true" id="tel-yes"><label for="tel-yes">Yes</label>
                        <input type="radio" asp-for="Input.HasRegisteredTelephone" value="false" id="tel-no"><label for="tel-no">No</label>
                    </div>
                    <span asp-validation-for="Input.HasRegisteredTelephone" class="error"></span>
                </div>
                <div class="field">
                    <span class="field-label" id="fw-label">@Html.DisplayNameFor(m => m.Input.IsForeignWorker)</span>
                    <div class="segmented" role="radiogroup" aria-labelledby="fw-label">
                        <input type="radio" asp-for="Input.IsForeignWorker" value="true" id="fw-yes"><label for="fw-yes">Yes</label>
                        <input type="radio" asp-for="Input.IsForeignWorker" value="false" id="fw-no"><label for="fw-no">No</label>
                    </div>
                    <span asp-validation-for="Input.IsForeignWorker" class="error"></span>
                </div>
            </div>
        </div>
        <div class="panel-foot">Personal status and foreign worker are inputs of the original dataset. Their use is a stated limitation of the model.</div>
    </section>

    <section class="panel">
        <div class="panel-body">
            <div class="panel-head">
                <h2>Loan</h2>
                <p>What is being requested.</p>
            </div>
            <div class="grid">
                <div class="field">
                    <label asp-for="Input.CreditAmount"></label>
                    <div class="affix"><input asp-for="Input.CreditAmount" type="text" inputmode="numeric" placeholder="@BusinessLimits.MinCreditAmount.ToString("N0")–@BusinessLimits.MaxCreditAmount.ToString("N0")"><span>DM</span></div>
                    <span asp-validation-for="Input.CreditAmount" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.DurationMonths"></label>
                    <div class="affix"><input asp-for="Input.DurationMonths" type="text" inputmode="numeric" placeholder="@BusinessLimits.MinDurationMonths–@BusinessLimits.MaxDurationMonths"><span>months</span></div>
                    <span asp-validation-for="Input.DurationMonths" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Purpose"></label>
                    <select asp-for="Input.Purpose" asp-items="Labels.Options<LoanPurpose>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.Purpose" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.InstallmentSharePercent"></label>
                    <div class="affix"><input asp-for="Input.InstallmentSharePercent" type="text" inputmode="decimal" step="0.1" placeholder="0–100"><span>%</span></div>
                    <span class="hint">Monthly installment as a share of disposable income</span>
                    <span asp-validation-for="Input.InstallmentSharePercent" class="error"></span>
                </div>
                <div class="field span-2">
                    <label asp-for="Input.OtherDebtors"></label>
                    <select asp-for="Input.OtherDebtors" asp-items="Labels.Options<OtherDebtors>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.OtherDebtors" class="error"></span>
                </div>
            </div>
        </div>
        <div class="panel-foot">Amounts are in 1970s Deutsche Mark. The model was trained on loans of @BusinessLimits.MinCreditAmount.ToString("N0") to @BusinessLimits.MaxCreditAmount.ToString("N0") DM.</div>
    </section>

    <section class="panel">
        <div class="panel-body">
            <div class="panel-head">
                <h2>Finances</h2>
                <p>Accounts, savings and credit record.</p>
            </div>
            <div class="grid">
                <div class="field span-2">
                    <label asp-for="Input.CheckingAccountStatus"></label>
                    <select asp-for="Input.CheckingAccountStatus" asp-items="Labels.Options<CheckingAccountStatus>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.CheckingAccountStatus" class="error"></span>
                </div>
                <div class="field span-2">
                    <label asp-for="Input.CreditHistory"></label>
                    <select asp-for="Input.CreditHistory" asp-items="Labels.Options<CreditHistory>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.CreditHistory" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.SavingsAccount"></label>
                    <select asp-for="Input.SavingsAccount" asp-items="Labels.Options<SavingsAccount>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.SavingsAccount" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.CreditsAtBank"></label>
                    <input asp-for="Input.CreditsAtBank" type="text" inputmode="numeric" placeholder="1">
                    <span class="hint">Including this one</span>
                    <span asp-validation-for="Input.CreditsAtBank" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.OtherInstallmentPlans"></label>
                    <select asp-for="Input.OtherInstallmentPlans" asp-items="Labels.Options<OtherInstallmentPlans>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.OtherInstallmentPlans" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Property"></label>
                    <select asp-for="Input.Property" asp-items="Labels.Options<PropertyType>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.Property" class="error"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-body">
            <div class="panel-head">
                <h2>Work and housing</h2>
                <p>Employment and where the applicant lives.</p>
            </div>
            <div class="grid">
                <div class="field">
                    <label asp-for="Input.EmploymentDuration"></label>
                    <select asp-for="Input.EmploymentDuration" asp-items="Labels.Options<EmploymentDuration>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.EmploymentDuration" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Job"></label>
                    <select asp-for="Input.Job" asp-items="Labels.Options<JobType>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.Job" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Housing"></label>
                    <select asp-for="Input.Housing" asp-items="Labels.Options<Housing>()" required><option value="">Select…</option></select>
                    <span asp-validation-for="Input.Housing" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.YearsAtResidence"></label>
                    <div class="affix"><input asp-for="Input.YearsAtResidence" type="text" inputmode="numeric" placeholder="0"><span>years</span></div>
                    <span asp-validation-for="Input.YearsAtResidence" class="error"></span>
                </div>
            </div>
        </div>
    </section>

    <div class="action-bar">
        <span>Submitted as @User.Identity!.Name. You will get a recommendation, not a decision.</span>
        <button type="submit" class="button button-primary">Get recommendation</button>
    </div>
</form>
