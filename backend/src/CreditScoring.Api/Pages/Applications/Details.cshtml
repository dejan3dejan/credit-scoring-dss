@page "/applications/{id:guid}"
@model CreditScoring.Api.Pages.Applications.DetailsModel
@using System.Globalization
@{
    var a = Model.Application;
    var d = a.Decision;
    ViewData["Title"] = a.ApplicantName;
    string Usd(decimal value) => value.ToString("N0", CultureInfo.InvariantCulture) + " USD";
    string Tone(Recommendation r) => r switch
    {
        Recommendation.Approve => "approve",
        Recommendation.Review => "review",
        _ => "reject",
    };
    string N(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    const double Radius = 90;
    var canRescore = Model.CanDecide && a.OfficerDecision is null && d?.Status != DecisionStatus.Scored;
    var circumference = 2 * Math.PI * Radius;
    void Tick(double at, string css)
    {
        var angle = at * 2 * Math.PI;
        <line class="@css" x1="@N(100 + 76 * Math.Cos(angle))" y1="@N(100 + 76 * Math.Sin(angle))" x2="@N(100 + 104 * Math.Cos(angle))" y2="@N(100 + 104 * Math.Sin(angle))"/>
    }
}

@section Band {
    <div class="band-person">
        <span class="avatar avatar-lg tone-@Avatar.Tone(a.ApplicantName)" aria-hidden="true">@Avatar.Initials(a.ApplicantName)</span>
        <div>
            <a class="back" asp-page="Index">
                <svg width="8" height="12" viewBox="0 0 8 12" aria-hidden="true"><path d="M6 1 1.5 6 6 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                History
            </a>
            <h1><a class="title-link" asp-page="/Clients/Details" asp-route-id="@a.ClientId">@a.ApplicantName</a></h1>
            <p><span class="mono">@a.ClientNumber</span> · @a.LoanAmount.ToString("N0") USD over @a.TermMonths months · @Labels.Of(a.Purpose) · submitted by @a.SubmittedBy</p>
        </div>
    </div>
    @if (Model.CanDecide)
    {
        <a class="button" asp-page="New">New application</a>
    }
}

<section class="panel">
    @if (d is not null && d.Status == DecisionStatus.Scored && d.PBad is { } pBad && d.ThresholdUsed is { } threshold && d.Recommendation is { } recommendation)
    {
        var tone = Tone(recommendation);
        var reviewFrom = d.ReviewFromUsed;
        var ringLabel = reviewFrom is { } rf
            ? $"Probability of default {pBad:P1}; review closely from {rf:P1}, reject from {threshold:P1}"
            : $"Probability of default {pBad:P1}, reject threshold {threshold:P1}";
        <div class="result">
            <div class="gauge" role="img" aria-label="@ringLabel">
                <svg viewBox="0 0 200 200" aria-hidden="true">
                    <circle class="gauge-track" cx="100" cy="100" r="@N(Radius)"/>
                    @if (reviewFrom is { } band)
                    {
                        <circle class="gauge-band" cx="100" cy="100" r="@N(Radius)"
                                stroke-dasharray="0 @N(band * circumference) @N((threshold - band) * circumference) @N(circumference)"/>
                    }
                    <circle class="gauge-value gauge-@tone" cx="100" cy="100" r="@N(Radius)"
                            stroke-dasharray="@N(Math.Max(pBad * circumference, 0.01)) @N(circumference)"/>
                    @if (reviewFrom is { } from)
                    {
                        Tick(from, "gauge-tick gauge-tick-soft");
                    }
                    @{ Tick(threshold, "gauge-tick"); }
                </svg>
                <div class="gauge-center">
                    <div class="gauge-number">@pBad.ToString("P1")</div>
                    <div class="gauge-caption">Probability of default</div>
                </div>
            </div>
            <div>
                <div class="eyebrow">Recommendation</div>
                <div class="verdict verdict-@tone">@Labels.Of(recommendation)</div>
                <p class="result-text">
                    @(recommendation switch
                    {
                        Recommendation.Approve when reviewFrom is not null => "The estimated probability of default is below the review band, which starts at the first mark on the ring.",
                        Recommendation.Approve => "The estimated probability of default is below the reject threshold, marked on the ring.",
                        Recommendation.Review => "The estimated probability of default is inside the review band, between the two marks on the ring. The model is least sure here: check the application closely and give a reason for your decision.",
                        _ => "The estimated probability of default is at or above the reject threshold, the last mark on the ring.",
                    })
                </p>
                <dl class="facts">
                    <div><dt>P(bad)</dt><dd class="mono">@pBad.ToString("0.0000", CultureInfo.InvariantCulture)</dd></div>
                    @if (reviewFrom is { } shown)
                    {
                        <div><dt>Review from</dt><dd class="mono">≥ @shown.ToString("0.0000", CultureInfo.InvariantCulture)</dd></div>
                    }
                    <div><dt>Reject at</dt><dd class="mono">≥ @threshold.ToString("0.0000", CultureInfo.InvariantCulture)</dd></div>
                    <div><dt>Model</dt><dd class="mono">@d.ModelId</dd></div>
                    <div><dt>Scored</dt><dd>@d.EvaluatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd></div>
                </dl>
            </div>
        </div>
    }
    else
    {
        <div class="result">
            <div class="gauge-empty">No score</div>
            <div>
                <div class="eyebrow">Recommendation</div>
                <div class="verdict verdict-unavailable">Scoring unavailable</div>
                <p class="result-text">
                    @(d?.ErrorCode is { } code ? Labels.ScoringError(code) ?? "The scoring service failed." : "No scoring result was recorded.")
                    No recommendation was made and no score was substituted.
                    @(canRescore ? "Score it again once the service is back, or assess the application manually." : "")
                </p>
                <dl class="facts">
                    <div><dt>Error code</dt><dd class="mono">@(d?.ErrorCode ?? "none")</dd></div>
                    <div><dt>Attempted</dt><dd>@(d?.EvaluatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "–")</dd></div>
                    @if (a.ScoringFailures.Count > 0)
                    {
                        <div><dt>Earlier attempts</dt><dd>@a.ScoringFailures.Count</dd></div>
                    }
                </dl>
                @if (Model.RescoreMessage is { } message)
                {
                    <div class="alert" role="alert">@message</div>
                }
                @if (canRescore)
                {
                    <form method="post" asp-page-handler="Rescore" class="rescore">
                        <button type="submit" class="button">Score again</button>
                    </form>
                }
            </div>
        </div>
    }
    <div class="panel-foot">
        <span>Reference <span class="mono">@a.Id</span></span>
        <span>Submitted @a.SubmittedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
    </div>
</section>

<div class="note">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm.75 10.5h-1.5v-4.5h1.5v4.5ZM8 5.75a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/></svg>
    <div>
        <strong>Decision support, not a decision.</strong>
        The model estimates risk from 18 answers and recommends an action; the loan officer makes and owns the credit decision.
        It learned from Lending Club loans issued in the United States from 2012 to 2014, so its estimates reflect those borrowers and that period.
    </div>
</div>

<section class="panel decision" id="decision">
    <div class="panel-body">
        <div class="panel-head">
            <h2>Your decision</h2>
            <p>The recommendation supports you. The decision, and the reason for it, are yours.</p>
        </div>

        @if (a.OfficerDecision is { } od)
        {
            var finalTone = od.Outcome == FinalDecision.Approve ? "approve" : "reject";
            <div class="final">
                <span class="verdict verdict-sm verdict-@finalTone">@Labels.Of(od.Outcome)</span>
                @if (od.IsOverride)
                {
                    <span class="tag tag-override">Override</span>
                }
            </div>
            @if (od.Reason is { } reason)
            {
                <blockquote class="reason">@reason</blockquote>
            }
            <p class="muted">Recorded by @od.DecidedBy on @od.DecidedAt.ToLocalTime().ToString("d MMM yyyy 'at' HH:mm"). A recorded decision cannot be changed.</p>
        }
        else if (!Model.CanDecide)
        {
            <p class="muted">Awaiting the loan officer's decision. Your role can view applications but not decide them.</p>
        }
        else
        {
            var recommended = d?.Recommendation;
            @if (Model.AlreadyDecidedElsewhere)
            {
                <div class="alert" role="alert">A decision was already recorded for this application, so yours was not saved.</div>
            }
            <form method="post" novalidate class="decision-form">
                <div asp-validation-summary="ModelOnly" class="alert"></div>
                <div class="field">
                    <span class="field-label" id="outcome-label">@Html.DisplayNameFor(m => m.Review.Outcome)</span>
                    <div class="segmented segmented-lg" role="radiogroup" aria-labelledby="outcome-label">
                        <input type="radio" asp-for="Review.Outcome" value="Approve" id="outcome-approve"><label for="outcome-approve">Approve</label>
                        <input type="radio" asp-for="Review.Outcome" value="Reject" id="outcome-reject"><label for="outcome-reject">Reject</label>
                    </div>
                    <span asp-validation-for="Review.Outcome" class="error"></span>
                </div>
                <div class="field">
                    <label asp-for="Review.Reason"></label>
                    <textarea asp-for="Review.Reason" rows="3" maxlength="@BusinessLimits.DecisionReasonMaxLength" placeholder="What you weighed, in a sentence or two"></textarea>
                    <span class="hint">
                        @(recommended switch
                        {
                            Recommendation.Review => "Required: the model asked for a closer review of this application.",
                            { } rec => $"Required if you decide against the recommendation ({Labels.Of(rec)}).",
                            null => "Required: no recommendation was made for this application.",
                        })
                    </span>
                    <span asp-validation-for="Review.Reason" class="error"></span>
                </div>
                <div class="decision-actions">
                    <span class="muted">Recorded as @User.Identity!.Name. A recorded decision cannot be changed.</span>
                    <button type="submit" class="button button-primary">Record decision</button>
                </div>
            </form>
        }
    </div>

    <aside class="timeline-wrap">
        <h3 class="timeline-title">Timeline</h3>
        <ol class="timeline">
            <li class="done">
                <span class="timeline-what">Submitted by @a.SubmittedBy</span>
                <span class="timeline-when">@a.SubmittedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
            </li>
            @foreach (var failure in a.ScoringFailures)
            {
                <li class="failed">
                    <span class="timeline-what">Scoring failed (<span class="mono">@failure.ErrorCode</span>)</span>
                    <span class="timeline-when">@failure.AttemptedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
                </li>
            }
            @if (d is null)
            {
                <li class="failed"><span class="timeline-what">No scoring result recorded</span></li>
            }
            else if (d.Status == DecisionStatus.Scored)
            {
                <li class="done">
                    <span class="timeline-what">Scored @d.PBad?.ToString("P1"), @(d.Recommendation switch
                    {
                        Recommendation.Review => "model asks for a closer review",
                        { } r => $"model recommends {Labels.Of(r).ToLowerInvariant()}",
                        null => "no recommendation",
                    })</span>
                    <span class="timeline-when">@d.EvaluatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm") · <span class="mono">@d.ModelId</span></span>
                </li>
            }
            else
            {
                <li class="failed">
                    <span class="timeline-what">Scoring failed (<span class="mono">@d.ErrorCode</span>)</span>
                    <span class="timeline-when">@d.EvaluatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
                </li>
            }
            @if (a.OfficerDecision is { } decided)
            {
                <li class="done">
                    <span class="timeline-what">@Labels.Of(decided.Outcome) by @decided.DecidedBy@(decided.IsOverride ? ", overriding the model" : "")</span>
                    <span class="timeline-when">@decided.DecidedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
                </li>
            }
            else
            {
                <li class="pending"><span class="timeline-what">Awaiting the officer's decision</span></li>
            }
        </ol>
    </aside>
</section>

@if (Model.ShadowScores is { } shadows)
{
    <h2 class="section-title">Other models</h2>
    <section class="panel">
        @if (shadows.Count == 0)
        {
            <div class="empty">
                <h2>No shadow models scored this application</h2>
                <p>Models registered as shadows score new applications next to the active one.</p>
            </div>
        }
        else
        {
            @foreach (var s in shadows)
            {
                var agrees = s.Recommendation is { } sr && d?.Recommendation is { } dr && sr == dr;
                <div class="shadow-row">
                    <div>
                        <div class="mono">@s.ModelId</div>
                        <div class="registry-meta">@s.ScoredAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")@(s.ThresholdUsed is { } st ? $" · rejects at {st:P1}" : "")</div>
                    </div>
                    <div class="shadow-score">
                        @if (s.Status == DecisionStatus.Scored && s.Recommendation is { } shadowRecommendation)
                        {
                            <span class="num">@s.PBad?.ToString("P1")</span>
                            <span class="status status-@Tone(shadowRecommendation)">@Labels.Of(shadowRecommendation)</span>
                            <span class="tag @(agrees ? "tag-agree" : "tag-override")">@(agrees ? "Agrees" : "Differs")</span>
                        }
                        else
                        {
                            <span class="status status-unavailable" title="@Labels.ScoringError(s.ErrorCode ?? "")">Not scored (@s.ErrorCode)</span>
                        }
                    </div>
                </div>
            }
        }
        <div class="panel-foot">Shown to managers and risk staff only. Shadow scores never change the recommendation or the officer's decision.</div>
    </section>
}

<h2 class="section-title">Application as submitted</h2>
<div class="cards">
    <section class="panel">
        <div class="card-title">Loan</div>
        <dl class="kv">
            <div><dt>Loan amount</dt><dd class="num">@a.LoanAmount.ToString("N0") USD</dd></div>
            <div><dt>Term</dt><dd>@a.TermMonths months</dd></div>
            <div><dt>Purpose</dt><dd>@Labels.Of(a.Purpose)</dd></div>
        </dl>
    </section>
    <section class="panel">
        <div class="card-title">Income and housing</div>
        <dl class="kv">
            <div><dt>Annual income</dt><dd class="num">@Usd(a.AnnualIncome)</dd></div>
            <div><dt>Income verification</dt><dd>@Labels.Of(a.IncomeVerification)</dd></div>
            <div><dt>Debt-to-income ratio</dt><dd class="num">@a.DebtToIncomePercent.ToString("0.##", CultureInfo.InvariantCulture)%</dd></div>
            <div><dt>Years in current job</dt><dd>@Labels.Of(a.EmploymentLength)</dd></div>
            <div><dt>Housing</dt><dd>@Labels.Of(a.HomeOwnership)</dd></div>
            <div><dt>Mortgage accounts</dt><dd>@a.MortgageAccounts</dd></div>
        </dl>
    </section>
    <section class="panel">
        <div class="card-title">Credit report</div>
        <dl class="kv">
            <div><dt>Credit score</dt><dd class="num">@a.CreditScore</dd></div>
            <div><dt>First credit line</dt><dd>@a.EarliestCreditLine.ToString("MMM yyyy") <span class="muted">(@a.CreditHistoryYears.ToString("0.0", CultureInfo.InvariantCulture) years)</span></dd></div>
            <div><dt>Inquiries, last 6 months</dt><dd>@a.InquiriesLast6Months</dd></div>
            <div><dt>Delinquencies, last 2 years</dt><dd>@a.DelinquenciesLast2Years</dd></div>
            <div><dt>Public records</dt><dd>@a.PublicRecords</dd></div>
            <div><dt>Bankruptcies</dt><dd>@a.Bankruptcies</dd></div>
        </dl>
    </section>
    <section class="panel">
        <div class="card-title">Credit accounts</div>
        <dl class="kv">
            <div><dt>Revolving balance</dt><dd class="num">@Usd(a.RevolvingBalance)</dd></div>
            <div><dt>Revolving utilisation</dt><dd class="num">@a.RevolvingUtilizationPercent.ToString("0.#", CultureInfo.InvariantCulture)%</dd></div>
            <div><dt>Open credit lines</dt><dd>@a.OpenAccounts</dd></div>
            <div><dt>Credit lines ever opened</dt><dd>@a.TotalAccounts</dd></div>
        </dl>
    </section>
</div>
